# Copy to .env and adjust.
SERVER_PORT=8080
RUST_LOG=info

# Image pipeline
SAFE_CROP_PX=20          # "almost fits" threshold in screen pixels
PD_FALLBACK_YEAR=1850    # accept records without licence info only if made by this year (0 = never)
PALETTE_REFERENCE=defined  # defined | sun | room | backlight (watch settings can override)
POOL_MAX_PAGES=80

# Tailscale (only for: docker compose --profile tailscale up -d)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=treasure-trove
