# Copy to .env and adjust.
RUST_LOG=info

# The generator's working directory (catalog.sqlite + master images)
DATA_DIR=./data

# Catalog artifact (scripts/catalog.sh fetch), e.g.
# https://github.com/<owner>/<repo>/releases/latest/download/catalog.tar.gz
CATALOG_URL=

# Generator
REQUESTS_PER_SECOND=1    # to the Rijksmuseum, its image server and Wikidata (0.5 = one every 2 s)
CONTACT=                 # your email or a URL, sent in the User-Agent. Wikimedia requires it for
                         # Wikipedia pageviews (Featured ranking); without it, articles are counted instead
REFRESH_DAYS=1           # re-check metadata/pools older than this (1: every run is fresh,
                         # a stopped run resumed the same day continues where it left off)
SAFE_CROP_PX=20          # "almost fits" threshold in screen pixels
PD_FALLBACK_YEAR=1850    # accept records without license info only if made by this year (0 = never)
POOL_MAX_PAGES=80
SOURCE_SIZE=1200         # longest side of the master image kept per painting (for planning crops)
