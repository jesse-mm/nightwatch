# Copy to .env and adjust.
SERVER_PORT=8080
RUST_LOG=info

# Where the generator writes and the server reads (catalog.sqlite + art/)
DATA_DIR=./data

# Server
PALETTE_REFERENCE=defined  # default colour tuning: defined | sun | room | backlight

# Generator
REQUESTS_PER_SECOND=1    # to the Rijksmuseum, its image server and Wikidata (0.5 = one every 2 s)
REFRESH_DAYS=25          # re-check metadata/pools older than this
SAFE_CROP_PX=20          # "almost fits" threshold in screen pixels
PD_FALLBACK_YEAR=1850    # accept records without licence info only if made by this year (0 = never)
POOL_MAX_PAGES=80
WEBP_QUALITY=90          # cropped originals

# Tailscale (only for: docker compose --profile tailscale up -d)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=treasure-trove
