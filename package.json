{
  "name": "nightwatch",
  "private": true,
  "license": "MIT",
  "description": "Pebble watchface showing a daily public-domain painting from the Rijksmuseum",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test 'watchface/test/*.test.js'",
    "lint:fix": "eslint . --fix",
    "site": "npx --yes serve@14.2.4 -l 8090 site",
    "emulator-images": "node scripts/emulator-images.mjs",
    "dev": "npm run emulator-images & npm run site",
    "build:watch": "cd watchface && NIGHTWATCH_ENV=production pebble build",
    "build:site": "node scripts/bundle-catalog.mjs && node scripts/build-site.mjs",
    "preview": "npm run build:site && wrangler dev --port 8091",
    "deploy": "npm run build:site && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "wrangler": "^4.151.2"
  }
}
