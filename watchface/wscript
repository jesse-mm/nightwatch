# Standard Pebble SDK 3+ build script (multi-platform C + bundled PebbleKit JS).
import os.path

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def write_config(ctx):
    """Point src/pkjs/config.js at config.dev.js or config.production.js.

    NIGHTWATCH_ENV=production or dev picks one; without it, dev when
    config.dev.js exists (it's not in git), else production.
    """
    pkjs = ctx.path.find_dir('src/pkjs').abspath()
    env = os.environ.get('NIGHTWATCH_ENV')
    if not env:
        has_dev = os.path.exists(os.path.join(pkjs, 'config.dev.js'))
        env = 'dev' if has_dev else 'production'
    if env not in ('dev', 'production'):
        ctx.fatal('NIGHTWATCH_ENV must be dev or production, not ' + env)
    if not os.path.exists(os.path.join(pkjs, 'config.' + env + '.js')):
        ctx.fatal('missing src/pkjs/config.' + env + '.js')
    text = ("// Generated by wscript (not in git): this build's settings.\n"
            "module.exports = require('./config." + env + "');\n")
    path = os.path.join(pkjs, 'config.js')
    old = None
    if os.path.exists(path):
        with open(path) as f:
            old = f.read()
    if old != text:
        with open(path, 'w') as f:
            f.write(text)
    print('NightWatch config: ' + env)


def build(ctx):
    ctx.load('pebble_sdk')
    write_config(ctx)
    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
